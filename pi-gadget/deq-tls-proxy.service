[Unit]
# Terminates TLS for the web frontend only, in front of the backend's
# existing plain-HTTP port. See deq_tls_proxy.py for why this exists as a
# second listener instead of putting TLS on the backend itself.
#
# It must never be able to take the DEQ link down: it touches nothing the
# gadget or the backend owns, and carries no state of its own. A crash
# here loses the browser's padlock, nothing else.
Description=DEQ Tune TLS proxy (web frontend only)
After=network.target deq-backend.service
Wants=deq-backend.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/deq/deq-tune/pi-gadget/deq_tls_proxy.py 8443 8420 /home/deq/deq-tls/cert.pem /home/deq/deq-tls/key.pem
Restart=on-failure
RestartSec=5

StandardOutput=append:/var/log/deq-tls-proxy.log
StandardError=append:/var/log/deq-tls-proxy.log

# Port 8443 needs no special capability (it is above 1024), but the
# listener itself should still have as little reach as a crashed or
# compromised process can use.
User=deq
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=64M

[Install]
WantedBy=multi-user.target
