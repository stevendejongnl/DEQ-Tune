{
  "name": "deq-tune-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "warm": "vite optimize --force",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "prepare": "ttsc prepare",
    "generate:dto": "npx --yes --package typescript@5.8.3 --package openapi-typescript@7 -- openapi-typescript ../openapi.json -o src/dto/generated/openapi.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "typia": "^15.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@ttsc/linux-x64": "^0.30.4",
    "@ttsc/unplugin": "^0.30.4",
    "jsdom": "^30.1.1",
    "ttsc": "^0.30.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
