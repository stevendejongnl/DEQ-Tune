    "/api/device/connect": {
      "post": {
        "tags": [
          "device"
        ],
        "summary": "Connect Device",
        "description": "Opens the link and runs the unit's startup sequence.\n\n`LinkKeeper` connects by itself, so the frontend does not call this route.\nThis route reports a failure in the body, and not as an error status. An\nunplugged unit is a normal state, and not a broken request.",
        "operationId": "connect_device_api_device_connect_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRead"
                }
              }
            }
          }
        }
      }
    },
    "/api/device/disconnect": {
      "post": {
        "tags": [
          "device"
        ],
        "summary": "Disconnect Device",
        "operationId": "disconnect_device_api_device_disconnect_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRead"
                }
              }
            }
          }
        }
      }
    },
    "/api/device/audio": {
      "get": {
        "tags": [
          "device"
        ],
        "summary": "Read Audio State",
        "description": "Reads what the unit is doing with sound, live from the unit.\n\nFour reads in one action, so they share one lock and give one consistent\npicture. Four separate reads could interleave with another caller.\n\nThis route stays out of `GET /api/device` on purpose. The header polls that\nroute, and it never opens a link. These reads cost USB exchanges.",
        "operationId": "read_audio_state_api_device_audio_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioStateRead"
                }
              }
            }
          }
        }
      }
    },
    "/api/device/volume": {
      "post": {
        "tags": [
          "device"
        ],
        "summary": "Set Volume",
        "description": "Sets the master volume, in dB.\n\nThe unit refuses a volume write with STATUS -6 while it holds THROUGH, and\ntakes one on an OTHER mode. So this route moves the mode, writes, and puts\nthe mode back. `scripts/probe_audio_output.py` does the same dance. Without\nit, the app could not set a volume before.",
        "operationId": "set_volume_api_device_volume_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VolumeWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioStateRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/device/play-ready": {
      "post": {
        "tags": [
          "device"
        ],
        "summary": "Send Play Ready",
        "description": "Tells the unit this device is ready to play audio (0x1a).\n\nThe real app sends it at the end of every cold start, and so does the\nconnect sequence here. Without it the car stayed silent for as long as the\nPi stayed attached. Sent alone in a car on 2026-10-11, it brought the audio\nback at once. This endpoint stays as a lever for a link that is up but\nsilent. It has no body and the reply is a status only.",
        "operationId": "send_play_ready_api_device_play_ready_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioStateRead"
                }
              }
            }
          }
        }
      }
    },
