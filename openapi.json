  },
  "components": {
    "schemas": {
      "AudioSourceWrite": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "AudioSourceWrite"
      },
      "AudioStateRead": {
        "properties": {
          "source_mode": {
            "type": "string",
            "title": "Source Mode"
          },
          "source_mode_wire": {
            "type": "integer",
            "title": "Source Mode Wire"
          },
          "volume_db": {
            "type": "integer",
            "title": "Volume Db"
          },
          "muted": {
            "type": "boolean",
            "title": "Muted"
          },
          "mute_state_wire": {
            "type": "integer",
            "title": "Mute State Wire"
          },
          "driving": {
            "type": "boolean",
            "title": "Driving"
          }
        },
        "type": "object",
        "required": [
          "source_mode",
          "source_mode_wire",
          "volume_db",
          "muted",
          "mute_state_wire",
          "driving"
        ],
        "title": "AudioStateRead",
        "description": "What the unit does with sound, read live from it.\n\nA separate model from `DeviceRead`, on purpose. The header polls that one,\nand it never opens a link. Every field here costs a request and a reply\nover USB. So the caller chooses when to ask for them.\n\nThis model exists because a tuning can apply without error and still give\nsilence, and nothing said so before. On 2026-10-09 a person applied\nprofiles and EQ styles in a car with no sound at all. The app could not\nshow whether the unit was on mute, near the bottom of its volume range, or\non a source that plays nothing."
      },
      "BridgeNoticeRead": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "first_seen_seconds": {
            "type": "number",
            "title": "First Seen Seconds"
          },
          "last_seen_seconds": {
            "type": "number",
            "title": "Last Seen Seconds"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "key",
          "severity",
          "message",
          "first_seen_seconds",
          "last_seen_seconds",
          "count"
        ],
        "title": "BridgeNoticeRead",
        "description": "One fault that the bridge saw since it started."
      },
      "BridgeRead": {
        "properties": {
          "undervoltage_now": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Undervoltage Now"
          },
          "undervoltage_since_boot": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Undervoltage Since Boot"
          },
          "uptime_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uptime Seconds"
          },
          "notices": {
            "items": {
              "$ref": "#/components/schemas/BridgeNoticeRead"
            },
            "type": "array",
            "title": "Notices",
            "default": []
          }
        },
        "type": "object",
        "title": "BridgeRead",
        "description": "What the app shows about the machine that holds the link.\n\nThis model describes the bridge, and not the DEQ. The two fail for\ndifferent reasons and ask different things of a person. A DEQ that is off\nis normal. A bridge that browns out has a fault in the wiring.\n\nThe undervoltage fields are `None` where the machine cannot tell. A laptop\nhas no `vcgencmd`, and `False` would be a claim it cannot make."
      },
      "CancellingEq": {
        "properties": {
          "L": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "L"
          },
          "R": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "R"
          }
        },
        "type": "object",
        "required": [
          "L",
          "R"
        ],
        "title": "CancellingEq"
      },
      "CancellingTA": {
        "properties": {
          "L": {
            "type": "number",
            "title": "L"
          },
          "R": {
            "type": "number",
            "title": "R"
          }
        },
        "type": "object",
        "required": [
          "L",
          "R"
        ],
        "title": "CancellingTA"
      },
      "ChannelBank": {
        "properties": {
          "isLocked": {
            "type": "boolean",
            "title": "Islocked"
          },
          "numOfBand": {
            "type": "integer",
            "title": "Numofband"
          },
          "selectedBank": {
            "type": "integer",
            "title": "Selectedbank"
          },
          "banks": {
            "$ref": "#/components/schemas/ChannelBankData"
          }
        },
        "type": "object",
        "required": [
          "isLocked",
          "numOfBand",
          "selectedBank",
          "banks"
        ],
        "title": "ChannelBank"
      },
      "ChannelBankData": {
        "properties": {
          "q": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Q"
          },
          "f0": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "F0"
          },
          "gain": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Gain"
          }
        },
        "type": "object",
        "required": [
          "q",
          "f0",
          "gain"
        ],
        "title": "ChannelBankData"
      },
      "DeqEnumValueRead": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "wire_value": {
            "type": "integer",
            "title": "Wire Value"
          }
        },
        "type": "object",
        "required": [
          "name",
          "wire_value"
        ],
        "title": "DeqEnumValueRead",
        "description": "One value the unit accepts, as the Pioneer app declares it."
      },
      "DeviceOptionsRead": {
        "properties": {
          "eq_styles": {
            "items": {
              "$ref": "#/components/schemas/DeqEnumValueRead"
            },
            "type": "array",
            "title": "Eq Styles"
          },
          "live_simulations": {
            "items": {
              "$ref": "#/components/schemas/DeqEnumValueRead"
            },
            "type": "array",
            "title": "Live Simulations"
          },
          "audio_sources": {
            "items": {
              "$ref": "#/components/schemas/DeqEnumValueRead"
            },
            "type": "array",
            "title": "Audio Sources"
          }
        },
        "type": "object",
        "required": [
          "eq_styles",
          "live_simulations",
          "audio_sources"
        ],
        "title": "DeviceOptionsRead",
        "description": "Every value set the unit's own DSP offers.\n\nThese come from the app, through `deq_enums.json`, so the frontend\nnever has to keep a list of its own."
      },
      "DeviceRead": {
        "properties": {
          "connected": {
            "type": "boolean",
            "title": "Connected"
          },
          "firmware_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Firmware Version"
          },
          "serial": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serial"
          },
          "problem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Problem"
          }
        },
        "type": "object",
        "required": [
          "connected"
        ],
        "title": "DeviceRead",
        "description": "What the header shows about the unit."
      },
      "EqStyleWrite": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "EqStyleWrite",
        "description": "Which built-in EQ style to select on the unit."
      },
      "FactoryCancel": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
