    "/api/bridge": {
      "get": {
        "tags": [
          "bridge"
        ],
        "summary": "Read Bridge",
        "description": "Returns the bridge's health, and everything that went wrong with it.\n\nA read raises a notice when the health says so. That lets a power dip\noutlive itself: the live reading recovers, and the notice stays until the\nbridge restarts.",
        "operationId": "read_bridge_api_bridge_get",
        "responses": {
